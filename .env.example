# Autocode settings — local only. Never commit real secrets.
#
# ★ EASY MODE: do not edit this by hand.
#    Just run:  ./start
#    The wizard fills in the important lines.

# --- Filled by ./start ---
NOTION_TOKEN=
NOTION_HUB_PAGE=
GITHUB_TOKEN=
WORKSPACE_REPOS=
AUTOCODE_DATA_ROOT=

# --- Notion browser sign-in (optional, once) ---
# Create a Public integration → Redirect URI http://127.0.0.1:8765/callback
# Then: ./scripts/connect_notion.sh   (opens Notion → Allow → saves NOTION_TOKEN)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_PORT=8765

# --- Host / paths ---
# Prefer home-writable defaults (Jetson user clones to ~/Hawkeye without /opt).
# ./bootstrap/05_use_data_ssd.sh rewrites these onto your NVMe when present.
AUTOCODE_HOME=
AUTOCODE_DATA_ROOT=
WORKSPACE_ROOT=
OLLAMA_MODELS=
SWAPFILE=
AUTOCODE_SWAP_GB=16
TZ=UTC

# --- Safety (./start turns autopilot on when healthy) ---
AUTOCODE_AUTOPILOT_ENABLED=0
# Daytime / always-on coding (worker timer every ~30 min). Needs autopilot=1 too.
AUTOCODE_CONTINUOUS_ENABLED=0
AUTOCODE_MAX_TASKS_PER_CYCLE=1
# Keep working Ready tasks until empty each worker tick (project autopilot).
AUTOCODE_DRAIN_UNTIL_EMPTY=1
AUTOCODE_MAX_TASKS_PER_DRAIN=50
# Self-feed: enqueue IMPROVE:/BUG: follow-ups + routine health checks into Notion.
AUTOCODE_SELF_FEED_ENABLED=1
AUTOCODE_HEALTH_FEED_ENABLED=1
AUTOCODE_HEALTH_FEED_INTERVAL_SEC=21600
AUTOCODE_SELF_FEED_COOLDOWN_SEC=86400
AUTOCODE_LOCAL_ONLY=0

# Ollama (local primary)
# Jetson Orin Nano: 1.5B + 4k ctx (3B/7B often cudaMalloc OOM on 8GB unified memory).
# create_coder_64k.sh auto-picks on tegra; override with BASE_MODEL= / OLLAMA_NUM_CTX=
# CPU fallback: OLLAMA_NUM_GPU=0
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=coder-64k
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_CTX=
BASE_MODEL=
# OLLAMA_NUM_GPU=0

# --- Hermes ---
HERMES_API_TIMEOUT=1800
HERMES_CONFIG_DIR=~/.hermes

# --- Notion DBs (auto-created from NOTION_HUB_PAGE) ---
NOTION_BUILD_QUEUE_DB=
NOTION_AGENT_RUNS_DB=
NOTION_ESCALATION_LOG_DB=

# --- Autopilot budgets ---
AUTOCODE_MAX_TASKS_PER_NIGHT=2
AUTOCODE_MAX_WALL_MINUTES=90
AUTOCODE_MAX_TOOL_ITERATIONS=40
AUTOCODE_MAX_LOCAL_ATTEMPTS=2
AUTOCODE_BRANCH_PREFIX=hermes
AUTOCODE_MIN_RAM_MB=2500
AUTOCODE_MIN_DISK_GB=5
AUTOCODE_MAYBE_LOCAL_MIN_RAM_MB=4000
AUTOCODE_COST_PROFILE=cursor-grok
AUTOCODE_CLOUD_PREFERENCE=cursor
AUTOCODE_DISABLE_METERED_GROK=1

# --- GitHub ---
GH_HOST=github.com

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTOCODE_TELEGRAM_PROGRESS=1
AUTOCODE_STUCK_SECONDS=900

# --- Local dashboard (./scripts/ui.sh) ---
AUTOCODE_UI_HOST=127.0.0.1
AUTOCODE_UI_PORT=8787
# Set to 1 (or pass --remote) to bind Tailscale IP / LAN for phone monitoring
AUTOCODE_UI_REMOTE=0
# Hawkeye private deploy: work-email login + Secure cookies behind HTTPS tunnel
AUTOCODE_PRODUCT_NAME=Hawkeye
AUTOCODE_PRIVATE_MODE=1
# Only @brownhawke.engineering emails may sign in
HAWKEYE_ALLOWED_EMAIL_DOMAIN=brownhawke.engineering
# Password hashes live in config/users.json (see scripts/set_work_user.py)
HAWKEYE_USERS_FILE=config/users.json
# Legacy single-user fallback (optional if users.json is present)
AUTOCODE_PRIVATE_USER=
AUTOCODE_PRIVATE_PASSWORD_HASH=
AUTOCODE_PRIVATE_SESSION_HOURS=720
# Public hostname for Hawkeye (Cloudflare Tunnel DNS)
AUTOCODE_PUBLIC_HOST=hawkeye.brownhawke.engineering
# 0 = local free all day, escalate hard asks to Cursor/Grok (recommended)
AUTOCODE_PERSONAL_LOCAL_ONLY=0
AUTOCODE_UI_SECURE=0

# --- Hawkeye memory + research (private; SSD) ---
HAWKEYE_MEMORY_ENABLED=1
# Defaults to $AUTOCODE_DATA_ROOT/hawkeye/memory after bootstrap/05_use_data_ssd.sh
HAWKEYE_MEMORY_DIR=
HAWKEYE_MEMORY_TOP_K=5
# Passphrase or hex — encrypts each memories.jsonl line at rest
HAWKEYE_MEMORY_KEY=
# Optional dedicated key for per-user connection secrets (else MEMORY_KEY)
# HAWKEYE_SECRETS_KEY=
# HAWKEYE_ACCOUNTS_DIR=
# Comma-separated admins for Account → Machine (default: all work users)
# HAWKEYE_ADMIN_EMAILS=brandon@brownhawke.engineering

# --- Jetson auto-update (hawkeye-update.timer every 5 min) ---
HAWKEYE_UPDATE_ENABLED=1
# Empty = track current git branch; set to main after merges land
# HAWKEYE_UPDATE_BRANCH=main
HAWKEYE_UPDATE_REMOTE=origin
HAWKEYE_UPDATE_RECREATE_MODEL=1

# Cloudflare Tunnel install token (also settable from Account → Machine)
# TUNNEL_TOKEN=

HAWKEYE_RESEARCH_ENABLED=1
HAWKEYE_RESEARCH_DEEP=1
HAWKEYE_RESEARCH_TOP_K=5
HAWKEYE_RESEARCH_FETCH_MAX=3
HAWKEYE_RESEARCH_ALWAYS=0
# Optional preferred search provider (else DuckDuckGo HTML)
BRAVE_SEARCH_API_KEY=

# --- Email inbox (Resend receiving → draft → approve send) ---
HAWKEYE_MAIL_ENABLED=0
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
HAWKEYE_MAIL_FROM=
HAWKEYE_MAIL_SECURITY=domain
HAWKEYE_MAIL_ALLOWED_SENDERS=
HAWKEYE_MAIL_AUTO_DRAFT=1
HAWKEYE_MAIL_AUTO_SEND=0
# HAWKEYE_MAIL_DIR=

# --- Notion PM boards (Hawkeye UI project view) ---
# Primary Build Queue (defaults to Hawkeye board id when unset + HAWKEYE_NOTION_USE_DEFAULTS=1)
# NOTION_BUILD_QUEUE_DB=
# NOTION_ROSE_PROJECTS_DB=
# NOTION_LCM_BUILD_QUEUE_DB=
HAWKEYE_NOTION_USE_DEFAULTS=1
# Force sample board data in UI (1) or use live Notion when token is set (0)
HAWKEYE_PM_MOCK=0

# --- Cloud delegates (optional later) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
CURSOR_API_KEY=
CURSOR_WEBHOOK_URL=
CURSOR_WEBHOOK_TOKEN=
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_TOKEN=
AUTOCODE_CURSOR_DELEGATE_CMD=./scripts/delegate_cursor.sh
AUTOCODE_GROK_DELEGATE_CMD=./scripts/delegate_grok.sh
AUTOCODE_DELEGATE_TIMEOUT_SEC=120
AUTOCODE_CLAUDE_MODEL=claude-sonnet-4-20250514
AUTOCODE_GROK_MODEL=grok-2-latest
AUTOCODE_OPENROUTER_MODEL=x-ai/grok-2
